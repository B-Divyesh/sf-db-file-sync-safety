{
  "name": "db-file-sync-safety-site",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:site": "vite build",
    "build": "cargo build --release && npm run build:site",
    "typecheck": "tsc --noEmit",
    "test:performance": "npm run build:site && node scripts/performance-audit.mjs",
    "test:rust": "cargo test",
    "test": "npm run test:rust && npm run build:site && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "lighthouse": "13.4.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  }
}
